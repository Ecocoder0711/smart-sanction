# PostgreSQL connection using the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/smart_sanction

# Required for authentication. Generate a random secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RECOMMENDED_PARTNER_RADIUS_KM=50
ML_AVAILABLE=false

# Optional application settings use a prefix to avoid collisions with system variables.
SMART_SANCTION_ENVIRONMENT=development
SMART_SANCTION_DEBUG=false
