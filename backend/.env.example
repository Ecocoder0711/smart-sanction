# The names below are exact. Settings declare SMART_SANCTION_ as an env_prefix,
# but a field with an explicit validation_alias is read by that alias ALONE and
# the prefix is not applied to it. So every variable in the first block is read
# WITHOUT a prefix -- SMART_SANCTION_ML_AVAILABLE, for example, is ignored.

# PostgreSQL connection using the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/smart_sanction

# Required for authentication. Generate a random secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RECOMMENDED_PARTNER_RADIUS_KM=50

# Gates every ML call. Keep false by default: with a trained artifact absent
# the adapter reports itself unavailable anyway, and deterministic matching is
# unaffected either way. Enable it per-run instead of editing this file:
#   ML_AVAILABLE=true uvicorn app.main:app --reload
ML_AVAILABLE=false

# Settings below have no alias, so these DO take the SMART_SANCTION_ prefix.
SMART_SANCTION_ENVIRONMENT=development
SMART_SANCTION_DEBUG=false
