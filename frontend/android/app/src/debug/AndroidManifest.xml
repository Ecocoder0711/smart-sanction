<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ blocks plaintext HTTP by default. The local FastAPI server
         is reached over http:// during development, so cleartext is enabled
         HERE ONLY: this manifest is merged into debug builds and never into
         release builds, which keep the secure default.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />
</manifest>
